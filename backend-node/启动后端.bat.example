@echo off
REM Template — copy to 启动后端.bat and fill in your real Kuaidi100 credentials
REM Get them at https://www.kuaidi100.com/ (registered account, real-name verified)

set KUAIDI100_KEY=YOUR_KEY_HERE
set KUAIDI100_CUSTOMER=YOUR_CUSTOMER_HERE

cd /d D:\delivery_assistant\backend-node
echo Starting backend on port 8080...
node server.js
pause
